{
  "vocabulary": {
    "products": ["shoe", "shirt", "pants", "jacket", "dress", "laptop", "phone", "watch", "bag", "sweater", "hoodie", "jeans", "sneaker", "boot"],
    "actions": ["search", "find", "buy", "add", "remove", "order", "track", "show", "view", "check", "get", "purchase"],
    "attributes": ["color", "size", "material", "brand", "price", "style", "fit"],
